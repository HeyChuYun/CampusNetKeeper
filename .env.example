# Required: your existing campus network account. Do not commit the real values.
GWIFI_ACCOUNT=your_account
GWIFI_PASSWORD=your_password

# Leave empty unless your portal requires an account type. Phone accounts are commonly 2.
GWIFI_ACCOUNT_TYPE=

# Defaults are suitable for the inspected GiWiFi portal.
PORTAL_URL=http://10.4.0.5/gportal/web/login
CHECK_URLS=http://connectivitycheck.gstatic.com/generate_204,http://www.msftconnecttest.com/connecttest.txt

# Seconds. The default checks once per day; an offline state still retries every minute.
CHECK_INTERVAL=86400
RETRY_INTERVAL=60
REQUEST_TIMEOUT=10

# A 124 response means another session may need to be disconnected first.
# Keep this false unless you explicitly want that behavior.
ALLOW_SESSION_REPLACE=false

LOG_LEVEL=INFO
STATE_FILE=/data/cookies.txt
